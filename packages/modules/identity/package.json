{
  "name": "@plunderclips/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./proxy": "./src/proxy.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "auth:schema": "auth generate --config ./auth.cli.ts --output ../../db/src/schema/identity.ts --yes",
    "test": "vitest run",
    "seed:dev": "tsx --env-file-if-exists=../../../apps/web/.env.local scripts/seed-dev.ts"
  },
  "dependencies": {
    "@better-auth/infra": "0.4.29",
    "@plunderclips/db": "workspace:*",
    "@plunderclips/shared": "workspace:*",
    "better-auth": "1.7.21",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "auth": "1.7.21",
    "tsx": "4.23.15"
  }
}
