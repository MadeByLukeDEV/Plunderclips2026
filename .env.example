# Copy to apps/web/.env.local for development (and to docker/.env for compose).
DATABASE_URL=postgres://plunder:plunder@localhost:5432/plunderclips
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=change-me-to-a-random-32-plus-char-string
BETTER_AUTH_URL=http://localhost:3000
IP_HASH_SALT=change-me-random-16-plus

# OAuth (fill in as each provider is set up)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth redirect URLs to register with each provider:
#   {BETTER_AUTH_URL}/api/auth/callback/twitch | discord | kick | google

# Better Auth dashboard (optional, hosted by Better Auth: sends auth events to their cloud)
BETTER_AUTH_API_KEY=

# Dev login: test accounts per role on /sign-in, no OAuth apps needed. Ignored in production.
# After setting it: pnpm --filter @plunderclips/identity seed:dev
DEV_LOGIN=false

# Cloudflare Turnstile (anonymous clip submit)
# Required in production (submissions are refused without it). For local dev, Cloudflare's
# documented test keys always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
