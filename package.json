{
  "name": "plunderclips",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @plunderclips/db generate",
    "db:migrate": "pnpm --filter @plunderclips/db migrate",
    "db:studio": "pnpm --filter @plunderclips/db studio",
    "dev:services": "docker compose -f docker/compose.dev.yml up -d",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
